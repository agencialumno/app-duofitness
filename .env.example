# Copie para .env na raiz do app. Variáveis EXPO_PUBLIC_* vão DENTRO do app (qualquer
# pessoa pode extraí-las): NUNCA coloque segredos aqui, e sobretudo nunca a chave da Anthropic.

# URL do backend na Vercel (sem barra no fim). Vazio = app 100% offline.
EXPO_PUBLIC_API_URL=
# Mesmo valor do APP_KEY configurado no backend. Não é segredo de verdade: só reduz abuso.
EXPO_PUBLIC_APP_KEY=
# Opcional: tempo máximo (ms) esperando o primeiro token da IA antes de cair no roteiro offline. Padrão 10000.
# EXPO_PUBLIC_API_FIRST_TOKEN_TIMEOUT_MS=10000

# Opcional: número do WhatsApp do parceiro do marketplace (vitrine), com código do país e DDD, só dígitos
# (ex.: 5511999999999). Vazio = o botão "Falar no WhatsApp" avisa que o contato não foi configurado.
# EXPO_PUBLIC_MARKETPLACE_WHATSAPP=

# Opcional: liga a lotação real ("Academia agora") lendo EXPO_PUBLIC_API_URL/occupancy/<gymId>.
# Desligada (vazio) = dados de EXEMPLO, sempre rotulados. Ver docs/catraca.md. Nunca coloque chave aqui.
# EXPO_PUBLIC_OCCUPANCY_REMOTE=true

# Opcional: integração com Apple Saúde / Health Connect. Hoje é só um esqueleto (stubs), sem leitura de dados.
# Mantenha false. Ver docs/saude.md.
# EXPO_PUBLIC_HEALTH_INTEGRATION=false

# Opcional: "Como fazer" (vídeo/capa/placeholder) no detalhe do exercício. Ligada por padrão; "false" esconde a área.
# EXPO_PUBLIC_EXERCISE_VIDEOS=true

# Termos de Uso e Política de Privacidade (links no cadastro, no login, na etapa de idade e no Perfil). Vazio = o link some (nada quebra).
# No CI vêm das variáveis do repositório (Settings > Secrets and variables > Actions > Variables) com o MESMO nome.
EXPO_PUBLIC_TERMS_URL=https://duofitnessoficial.com.br/termos/
# EXPO_PUBLIC_PRIVACY_URL=
