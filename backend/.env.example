# Copie para .env (local) ou cadastre cada variável na Vercel (vercel env add).
# NUNCA commite o .env.

# --- Obrigatórias para /api/ia/chat ---
ANTHROPIC_API_KEY=
# Modelo usado no chat. Veja os ids vigentes na documentação da Anthropic.
ANTHROPIC_MODEL=
# Preços do MODELO ACIMA, em USD por milhão de tokens (consulte a página de preços).
# Servem para calcular o teto diário. Ao trocar ANTHROPIC_MODEL, troque estes também.
MODEL_INPUT_USD_PER_MTOK=
MODEL_OUTPUT_USD_PER_MTOK=
# Chave simples enviada pelo app no header x-app-key. NÃO é segredo (vai dentro do app).
# Gere uma qualquer: openssl rand -hex 16
APP_KEY=

# --- Opcionais ---
# Preços de cache de prompt. Padrão: escrita = 1,25x e leitura = 0,1x do preço de entrada.
# MODEL_CACHE_WRITE_USD_PER_MTOK=
# MODEL_CACHE_READ_USD_PER_MTOK=

# Teto de gasto por dia (UTC), em USD. Padrão 5.
DAILY_SPEND_LIMIT_USD=5
# Requisições por minuto por IP. Padrão 10.
RATE_LIMIT_PER_MIN=10
# Quantos turnos do usuário até a IA ser obrigada a entregar o plano. Padrão 8.
MAX_USER_TURNS=8
# Teto de tokens por resposta. Padrão 3000.
MAX_OUTPUT_TOKENS=3000
# Origens de navegador permitidas (CORS), separadas por vírgula. O app nativo não usa Origin.
# Vazio = nenhum navegador é aceito.
ALLOWED_ORIGINS=

# Upstash Redis (recomendado em produção): torna rate limit e teto diário compartilhados
# entre instâncias. Sem isso, os limites valem só por instância (melhor esforço).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
