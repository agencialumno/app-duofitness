{
  "expo": {
    "name": "Duo Fitness",
    "slug": "duo-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "./plugins/withAndroidRelease",
      "expo-font",
      "expo-asset"
    ],
    "ios": {
      "bundleIdentifier": "com.duofitness.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.duofitness.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan"
    },
    "extra": {
      "eas": {
        "projectId": "7fc18419-fec2-4323-ad36-f57d6ec95211"
      }
    },
    "owner": "duo-fitness"
  }
}
